# Copie para .env e ajuste os valores.
#   cp .env.example .env

# ---- obrigatorio ----
# Segredo de assinatura do JWT. Gere o seu: openssl rand -base64 48
# A aplicacao NAO sobe sem esta variavel.
JWT_SECRET=troque-por-um-segredo-de-64-caracteres-ou-mais-gerado-aleatoriamente

# ---- banco ----
# Rodando via docker compose, o host e "postgres"; localmente, "localhost".
POSTGRES_DB=finance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Usadas quando a aplicacao roda fora do compose:
DB_URL=jdbc:postgresql://localhost:5432/finance
DB_USER=postgres
DB_PASSWORD=postgres

# ---- opcionais ----
JWT_EXPIRATION=86400000              # 24h em ms
REFRESH_TOKEN_EXPIRATION=604800000   # 7 dias em ms
CORS_ALLOWED_ORIGINS=http://localhost:5173
MANAGEMENT_PORT=9091
SWAGGER_ENABLED=true

# ---- grafana ----
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
