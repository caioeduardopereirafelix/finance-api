{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend/browser",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://SEU-BACKEND.exemplo.com/v1/:path*"
    },
    {
      "source": "/transaction",
      "destination": "https://SEU-BACKEND.exemplo.com/transaction"
    },
    {
      "source": "/user",
      "destination": "https://SEU-BACKEND.exemplo.com/user"
    },
    {
      "source": "/account",
      "destination": "https://SEU-BACKEND.exemplo.com/account"
    },
    {
      "source": "/transaction/:path*",
      "destination": "https://SEU-BACKEND.exemplo.com/transaction/:path*"
    },
    {
      "source": "/user/:path*",
      "destination": "https://SEU-BACKEND.exemplo.com/user/:path*"
    },
    {
      "source": "/account/:path*",
      "destination": "https://SEU-BACKEND.exemplo.com/account/:path*"
    },
    {
      "source": "/bank/:path*",
      "destination": "https://SEU-BACKEND.exemplo.com/bank/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self'; script-src-attr 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.pluggy.ai https://connect.pluggy.ai; frame-src https://connect.pluggy.ai; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
